# TerraScope Environment Configuration

# Flask Server Configuration
FLASK_APP=backend/app.py
FLASK_ENV=development
PORT=5000
DEBUG=True
HOST=127.0.0.1

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5000

# NASA POWER API
NASA_POWER_API_BASE_URL=https://power.larc.nasa.gov/api/temporal/
NASA_POWER_TIMEOUT_SECONDS=30
NASA_POWER_MAX_RETRIES=3

# Geocoding Service (Nominatim)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_USER_AGENT=TerraScope-India-Trend-Detective/1.0 (contact: info@terrascope.org)
NOMINATIM_RATE_LIMIT_DELAY=1.0

# Data & Cache Storage Paths
CACHE_DIR=data/cache
PROCESSED_DATA_DIR=data/processed
SAMPLE_DATA_DIR=data/sample
GEOJSON_FILE_PATH=frontend/assets/geo/india_states.geojson

# Analysis Settings
DEFAULT_SIGNIFICANCE_ALPHA=0.05
DEFAULT_START_YEAR=2000
DEFAULT_END_MODE=latest
